     def from_json(cls, path: str | Path) -> "Stage2Config":
         with Path(path).open(encoding="utf-8") as stream:
             values = json.load(stream)
+        return cls.from_mapping(values)
+
+    @classmethod
+    def from_mapping(cls, values: dict[str, Any]) -> "Stage2Config":
+        """Build a config, accepting the nested block or the legacy flat keys.
+
+        Every ``resolved_config.json`` written before the early-stopping policy was
+        nested carries top-level ``patience``/``min_epochs``; those still load, so
+        old runs stay re-readable. Setting both forms is an error rather than a
+        silent precedence rule.
+        """
+
+        values = dict(values)
+        policy = values.pop("early_stopping", None)
+        legacy = {
+            name: values.pop(name)
+            for name in ("patience", "min_epochs")
+            if name in values
+        }
+        if policy is None:
+            policy = legacy
+        elif legacy:
+            raise ValueError(
+                "config sets early_stopping and the legacy top-level "
+                f"{sorted(legacy)}; keep exactly one form"
+            )
+        if not isinstance(policy, EarlyStopping):
+            policy = EarlyStopping(**dict(policy or {}))
+        values["early_stopping"] = policy
         return cls(**values)
 
 
