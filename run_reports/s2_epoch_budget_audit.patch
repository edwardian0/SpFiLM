+@dataclass(frozen=True)
+class EarlyStopping:
+    """Validation-metric monitor.
+
+    ``mode="monitor"`` is the default and never ends the epoch loop: the counter
+    still runs, the epoch at which the terminating rule would have fired is
+    recorded, and the best checkpoint is still selected on ``metric``.
+    ``mode="terminate"`` restores the historical break out of the loop.
+    """
+
+    mode: str = "monitor"
+    metric: str = "val_loss"
+    direction: str = "min"
+    min_delta: float = 1e-5
+    patience: int = 20
+    min_epochs: int = 30
+
+    def __post_init__(self) -> None:
+        if self.mode not in {"monitor", "terminate"}:
+            raise ValueError(
+                f"early_stopping.mode must be 'monitor' or 'terminate', got {self.mode!r}"
+            )
+        if self.direction not in {"min", "max"}:
+            raise ValueError(
+                f"early_stopping.direction must be 'min' or 'max', got {self.direction!r}"
+            )
+        if self.patience < 1:
+            raise ValueError("early_stopping.patience must be at least one epoch")
+        if self.min_delta < 0:
+            raise ValueError("early_stopping.min_delta must not be negative")
+        if self.min_epochs < 0:
+            raise ValueError("early_stopping.min_epochs must not be negative")
+
+    @property
+    def worst(self) -> float:
+        return math.inf if self.direction == "min" else -math.inf
+
+    def is_improvement(self, candidate: float, incumbent: float) -> bool:
+        if self.direction == "min":
+            return candidate < incumbent - self.min_delta
+        return candidate > incumbent + self.min_delta
+
+
+MONITORED_METRICS: dict[str, tuple[str, str]] = {
+    "val_disc_dice": ("disc", "dice_mean"),
+    "val_cup_dice": ("cup", "dice_mean"),
+    "val_disc_iou": ("disc", "iou_mean"),
+    "val_cup_iou": ("cup", "iou_mean"),
+}
+
+
+def monitored_value(
+    metric: str, val_loss: float, val_metrics: dict[str, Any]
+) -> float:
+    """Pull the configured monitored metric out of this epoch's validation pass."""
+
+    if metric in {"val_loss", "loss"}:
+        return val_loss
+    try:
+        structure, field = MONITORED_METRICS[metric]
+    except KeyError:
+        raise ValueError(
+            f"early_stopping.metric {metric!r} is not one of "
+            f"{['val_loss', *sorted(MONITORED_METRICS)]}"
+        ) from None
+    value = val_metrics[structure][field]
+    if value is None or not math.isfinite(float(value)):
+        raise RuntimeError(
+            f"early_stopping.metric {metric!r} was undefined at this epoch; it "
+            "cannot drive checkpoint selection"
+        )
+    return float(value)
 
 
